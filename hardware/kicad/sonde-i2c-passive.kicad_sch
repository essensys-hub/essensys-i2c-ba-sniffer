	(text
		"SONDE I2C PASSIVE — espion du bus BP / BA (lecture seule)"
		(exclude_from_sim no)
		(at 12.7 25.4 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid 709133e9-f925-53e0-9c20-5fe3091d60a7)
	)
	(text
		"3 fils côté bus (SDA, SCL, 0 V) ; position 4 (+15 V) du connecteur VIDE. Aucune pull-up, rien n'est alimenté par le bus.\nLe 0 V de la sonde est le 0 V de l'armoire : analyseur et Raspberry Pi sur batterie, jamais reliés au PE."
		(exclude_from_sim no)
		(at 12.7 31.75 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left bottom)
		)
		(uuid 536dbc09-c939-5424-ba9c-f2e6f0659f93)
	)
	(text
		"CÔTÉ BUS\nBA J1/J2 (WR-MPC3)\n1 SDA · 2 SCL · 3 0 V · 4 +15 V"
		(exclude_from_sim no)
		(at 7.62 41.91 0)
		(effects
